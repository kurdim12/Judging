# Secrets here are NOT loaded by `next dev` — they live in wrangler.
# Use `pnpm wrangler secret put <NAME>` for production secrets, and
# `.dev.vars` if you want to override them during `pnpm preview`.
#
# For convenient local Resend testing only:
RESEND_API_KEY=
EMAIL_FROM=IEEE UoP Hackathon <hackathon@example.com>
SITE_URL=http://localhost:3000
AUTH_SECRET=replace-with-32-plus-random-chars
BOOTSTRAP_ADMIN_EMAIL=you@uop.edu.jo
